# =============================================================================
# Client-side Environment Variables (Vite)
# =============================================================================
# These variables are exposed to the browser via Vite's `import.meta.env`.
# ONLY put your project URL and public Anon (publishable) key here.
# NEVER put your Service Role Key or Resend API Key in this file!
# =============================================================================

# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Custom Edge Function URL if different from default Supabase functions endpoint
# Default resolves to: `${VITE_SUPABASE_URL}/functions/v1/submit-contact`
# VITE_SUPABASE_EDGE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1/submit-contact

# =============================================================================
# Server-side Secrets for Supabase Edge Functions (DO NOT ADD TO CLIENT .env)
# =============================================================================
# Set these securely in the Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# or via Supabase CLI: `supabase secrets set KEY=VALUE`
#
# RESEND_API_KEY=re_your_resend_api_key
# CONTACT_NOTIFICATION_EMAIL=your-actual-email@gmail.com
# CONTACT_VERIFIED_SENDER=onboarding@resend.dev (or your verified domain sender like notifications@yourdomain.com)
# ALLOWED_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app
# =============================================================================
